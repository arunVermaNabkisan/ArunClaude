@page "/admin/settings"
@attribute [Authorize(Policy = "Administrator")]

<PageTitle>System Settings - Sambandh CRM</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/admin">Administration</a></li>
                    <li class="breadcrumb-item active">System Settings</li>
                </ol>
            </nav>
            <h2>System Settings</h2>
            <p class="text-muted">Configure system preferences and application settings</p>
        </div>
    </div>

    <div class="row">
        <!-- General Settings -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-gear me-2"></i>General Settings</h5>
                </div>
                <div class="card-body">
                    <form>
                        <div class="mb-3">
                            <label class="form-label">Application Name</label>
                            <input type="text" class="form-control" value="Sambandh CRM" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Company Name</label>
                            <input type="text" class="form-control" placeholder="Your Organization Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Time Zone</label>
                            <select class="form-select">
                                <option selected>India Standard Time (IST)</option>
                                <option>UTC</option>
                                <option>US Eastern Time</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Date Format</label>
                            <select class="form-select">
                                <option>DD/MM/YYYY</option>
                                <option selected>MMM DD, YYYY</option>
                                <option>MM/DD/YYYY</option>
                                <option>YYYY-MM-DD</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Currency</label>
                            <select class="form-select">
                                <option selected>INR (₹)</option>
                                <option>USD ($)</option>
                                <option>EUR (€)</option>
                            </select>
                        </div>
                        <button type="button" class="btn btn-primary">
                            <i class="bi bi-save me-2"></i>Save Changes
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Email Settings -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-envelope me-2"></i>Email Configuration</h5>
                </div>
                <div class="card-body">
                    <form>
                        <div class="mb-3">
                            <label class="form-label">SMTP Host</label>
                            <input type="text" class="form-control" placeholder="smtp.gmail.com" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">SMTP Port</label>
                            <input type="number" class="form-control" placeholder="587" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Username</label>
                            <input type="email" class="form-control" placeholder="email@example.com" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input type="password" class="form-control" placeholder="••••••••" />
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="enableSSL" checked />
                            <label class="form-check-label" for="enableSSL">
                                Enable SSL/TLS
                            </label>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-success">
                                <i class="bi bi-save me-2"></i>Save
                            </button>
                            <button type="button" class="btn btn-outline-secondary">
                                <i class="bi bi-envelope-check me-2"></i>Test Email
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Security Settings -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Security Settings</h5>
                </div>
                <div class="card-body">
                    <form>
                        <div class="mb-3">
                            <label class="form-label">Session Timeout (minutes)</label>
                            <input type="number" class="form-control" value="480" />
                            <small class="text-muted">Current: 8 hours (480 minutes)</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Password Minimum Length</label>
                            <input type="number" class="form-control" value="8" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Password Expiry (days)</label>
                            <input type="number" class="form-control" value="90" />
                            <small class="text-muted">0 = Never expires</small>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="requireSpecialChar" checked />
                            <label class="form-check-label" for="requireSpecialChar">
                                Require special characters in password
                            </label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="requireUppercase" checked />
                            <label class="form-check-label" for="requireUppercase">
                                Require uppercase letters
                            </label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="requireNumbers" checked />
                            <label class="form-check-label" for="requireNumbers">
                                Require numbers
                            </label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="enableAuditLog" checked />
                            <label class="form-check-label" for="enableAuditLog">
                                Enable audit logging
                            </label>
                        </div>
                        <button type="button" class="btn btn-danger">
                            <i class="bi bi-save me-2"></i>Save Changes
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Notification Settings -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-bell me-2"></i>Notification Settings</h5>
                </div>
                <div class="card-body">
                    <form>
                        <div class="mb-3">
                            <h6>Email Notifications</h6>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="notifyNewLead" checked />
                                <label class="form-check-label" for="notifyNewLead">
                                    New lead created
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="notifyLeadConverted" checked />
                                <label class="form-check-label" for="notifyLeadConverted">
                                    Lead converted to customer
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="notifyFollowUpDue" checked />
                                <label class="form-check-label" for="notifyFollowUpDue">
                                    Follow-up due reminder
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="notifyNewCustomer" />
                                <label class="form-check-label" for="notifyNewCustomer">
                                    New customer added
                                </label>
                            </div>
                        </div>

                        <hr />

                        <div class="mb-3">
                            <h6>System Notifications</h6>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="notifyUserLogin" checked />
                                <label class="form-check-label" for="notifyUserLogin">
                                    User login alerts
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="notifyDataChanges" checked />
                                <label class="form-check-label" for="notifyDataChanges">
                                    Critical data changes
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="notifyErrors" checked />
                                <label class="form-check-label" for="notifyErrors">
                                    System error alerts
                                </label>
                            </div>
                        </div>

                        <button type="button" class="btn btn-info">
                            <i class="bi bi-save me-2"></i>Save Changes
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Backup & Maintenance -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-warning">
                    <h5 class="mb-0"><i class="bi bi-database me-2"></i>Backup & Maintenance</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6>Database Backup</h6>
                        <p class="text-muted">Last backup: <strong>Never</strong></p>
                        <button type="button" class="btn btn-warning">
                            <i class="bi bi-cloud-download me-2"></i>Backup Now
                        </button>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <h6>Scheduled Backups</h6>
                        <select class="form-select mb-2">
                            <option>Disabled</option>
                            <option selected>Daily at 2:00 AM</option>
                            <option>Weekly on Sunday</option>
                            <option>Monthly on 1st</option>
                        </select>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="emailBackupReport" />
                            <label class="form-check-label" for="emailBackupReport">
                                Email backup completion report
                            </label>
                        </div>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <h6>Maintenance Mode</h6>
                        <p class="text-muted">Enable maintenance mode to prevent user access during system updates</p>
                        <button type="button" class="btn btn-outline-danger">
                            <i class="bi bi-shield-exclamation me-2"></i>Enable Maintenance Mode
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Integration Settings -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="bi bi-plug me-2"></i>Integration Settings</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6>MCA (Ministry of Corporate Affairs)</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="enableMCA" />
                            <label class="form-check-label" for="enableMCA">
                                Enable MCA verification
                            </label>
                        </div>
                        <input type="text" class="form-control mb-2" placeholder="API Key" />
                        <input type="text" class="form-control mb-2" placeholder="API Secret" />
                    </div>

                    <hr />

                    <div class="mb-3">
                        <h6>WhatsApp Business API</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="enableWhatsApp" />
                            <label class="form-check-label" for="enableWhatsApp">
                                Enable WhatsApp integration
                            </label>
                        </div>
                        <input type="text" class="form-control mb-2" placeholder="Business Phone Number" />
                        <input type="text" class="form-control mb-2" placeholder="API Token" />
                    </div>

                    <hr />

                    <div class="mb-3">
                        <h6>SMS Gateway</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="enableSMS" />
                            <label class="form-check-label" for="enableSMS">
                                Enable SMS notifications
                            </label>
                        </div>
                        <select class="form-select mb-2">
                            <option>Select Provider</option>
                            <option>Twilio</option>
                            <option>MSG91</option>
                            <option>TextLocal</option>
                        </select>
                        <input type="text" class="form-control" placeholder="API Credentials" />
                    </div>

                    <button type="button" class="btn btn-secondary">
                        <i class="bi bi-save me-2"></i>Save Integration Settings
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // Settings will be loaded from database/configuration
    // This is a placeholder implementation
}
