@page "/relationships/create"
@attribute [Authorize]
@inject IRelationshipRepository RelationshipRepo
@inject IIndividualRepository IndividualRepo
@inject ICustomerRepository CustomerRepo
@inject IUserRepository UserRepo
@inject NavigationManager Navigation
@using System.Security.Claims

<PageTitle>Add New Relationship - Sambandh CRM</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-diagram-3"></i> Add New Relationship</h3>
    <a href="/relationships" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Relationships
    </a>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = string.Empty)"></button>
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @successMessage
        <button type="button" class="btn-close" @onclick="@(() => successMessage = string.Empty)"></button>
    </div>
}

<EditForm Model="@relationship" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />

    <div class="card mb-3">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-person"></i> Individual Details</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-12">
                    <label for="individualId" class="form-label">Select Individual <span class="text-danger">*</span></label>
                    <InputSelect id="individualId" class="form-select" @bind-Value="relationship.IndividualId">
                        <option value="0">-- Select Individual --</option>
                        @foreach (var individual in individuals)
                        {
                            <option value="@individual.IndividualId">
                                @individual.FullName
                                @if (!string.IsNullOrEmpty(individual.PANNumber))
                                {
                                    <text> (PAN: @individual.PANNumber)</text>
                                }
                                @if (!string.IsNullOrEmpty(individual.MobileNumber))
                                {
                                    <text> - @individual.MobileNumber</text>
                                }
                            </option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => relationship.IndividualId)" />
                    <small class="text-muted">Select the individual who holds a position in the organization</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-building"></i> Organization Details</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-12">
                    <label for="customerId" class="form-label">Select Organization <span class="text-danger">*</span></label>
                    <InputSelect id="customerId" class="form-select" @bind-Value="relationship.CustomerId" @bind-Value:after="OnCustomerChanged">
                        <option value="0">-- Select Organization --</option>
                        @foreach (var customer in customers)
                        {
                            <option value="@customer.CustomerId">
                                @customer.EntityName (@customer.CustomerCode)
                                @if (!string.IsNullOrEmpty(customer.LegalConstitution))
                                {
                                    <text> - @customer.LegalConstitution</text>
                                }
                            </option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => relationship.CustomerId)" />
                    <small class="text-muted">Select the organization where the individual works</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-briefcase"></i> Role Information</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="roleInOrganization" class="form-label">Role in Organization <span class="text-danger">*</span></label>
                    <InputSelect id="roleInOrganization" class="form-select" @bind-Value="relationship.RoleInOrganization">
                        <option value="">-- Select Role --</option>
                        <option value="Chairman">Chairman</option>
                        <option value="Managing Director">Managing Director</option>
                        <option value="Director">Director</option>
                        <option value="CEO">CEO</option>
                        <option value="CFO">CFO</option>
                        <option value="COO">COO</option>
                        <option value="CTO">CTO</option>
                        <option value="General Manager">General Manager</option>
                        <option value="Manager">Manager</option>
                        <option value="Authorized Signatory">Authorized Signatory</option>
                        <option value="Key Management Personnel">Key Management Personnel</option>
                        <option value="Partner">Partner</option>
                        <option value="Trustee">Trustee</option>
                        <option value="Secretary">Secretary</option>
                        <option value="Other">Other</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => relationship.RoleInOrganization)" />
                </div>

                <div class="col-md-6">
                    <label for="roleSpecification" class="form-label">Role Specification</label>
                    <InputText id="roleSpecification" class="form-control" @bind-Value="relationship.RoleSpecification" placeholder="Additional role details" maxlength="255" />
                    <ValidationMessage For="@(() => relationship.RoleSpecification)" />
                    <small class="text-muted">Optional: Provide additional details about the role</small>
                </div>

                <div class="col-md-6">
                    <label for="roleStartDate" class="form-label">Role Start Date</label>
                    <InputDate id="roleStartDate" class="form-control" @bind-Value="relationship.RoleStartDate" />
                    <ValidationMessage For="@(() => relationship.RoleStartDate)" />
                </div>

                <div class="col-md-6">
                    <label for="isStillActive" class="form-label">Current Status</label>
                    <div class="form-check form-switch mt-2">
                        <InputCheckbox id="isStillActive" class="form-check-input" @bind-Value="relationship.IsStillActive" />
                        <label class="form-check-label" for="isStillActive">
                            Still active in this role
                        </label>
                    </div>
                </div>

                @if (!relationship.IsStillActive)
                {
                    <div class="col-md-6">
                        <label for="roleEndDate" class="form-label">Role End Date</label>
                        <InputDate id="roleEndDate" class="form-control" @bind-Value="relationship.RoleEndDate" />
                        <ValidationMessage For="@(() => relationship.RoleEndDate)" />
                    </div>
                }

                <div class="col-md-6">
                    <label class="form-label">Flags</label>
                    <div class="form-check">
                        <InputCheckbox id="isDecisionMaker" class="form-check-input" @bind-Value="relationship.IsDecisionMaker" />
                        <label class="form-check-label" for="isDecisionMaker">
                            <i class="bi bi-star-fill text-warning"></i> Decision Maker
                        </label>
                    </div>
                    <div class="form-check">
                        <InputCheckbox id="isPreferredContact" class="form-check-input" @bind-Value="relationship.IsPreferredContact" />
                        <label class="form-check-label" for="isPreferredContact">
                            <i class="bi bi-person-check-fill text-info"></i> Preferred Contact
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-person-badge"></i> Relationship Manager Assignment</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-12">
                    <label for="assignedToUserId" class="form-label">Assign Relationship Manager</label>
                    <InputSelect id="assignedToUserId" class="form-select" @bind-Value="assignedToUserId">
                        <option value="0">-- Select Relationship Manager --</option>
                        @foreach (var user in users)
                        {
                            <option value="@user.UserId">
                                @user.FullName (@user.Email)
                            </option>
                        }
                    </InputSelect>
                    <small class="text-muted">Optional: Assign a relationship manager to this customer. This will update the customer's assigned relationship manager.</small>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Saving...</span>
            }
            else
            {
                <i class="bi bi-save"></i>
                <span> Save Relationship</span>
            }
        </button>
        <a href="/relationships" class="btn btn-outline-secondary">
            <i class="bi bi-x-circle"></i> Cancel
        </a>
    </div>
</EditForm>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    private IndividualOrganization relationship = new();
    private List<Individual> individuals = new();
    private List<Customer> customers = new();
    private List<User> users = new();
    private int assignedToUserId = 0;
    private int? currentCustomerAssignedUserId = null;
    private bool isSaving = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Set default values
        relationship.IsStillActive = true;
        relationship.IsDecisionMaker = false;
        relationship.IsPreferredContact = false;
        relationship.CreatedDate = DateTime.Now;

        // Get current user ID for CreatedBy
        if (authenticationState != null)
        {
            var authState = await authenticationState;
            var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier);
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
            {
                relationship.CreatedBy = userId;
            }
        }

        // Load data for dropdowns
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            var allIndividuals = await IndividualRepo.GetAllAsync();
            individuals = allIndividuals.Where(i => i.IsActive).OrderBy(i => i.FullName).ToList();

            var allCustomers = await CustomerRepo.GetAllAsync();
            customers = allCustomers.Where(c => c.IsActive).OrderBy(c => c.EntityName).ToList();

            var allUsers = await UserRepo.GetAllAsync();
            users = allUsers.Where(u => u.IsActive).OrderBy(u => u.FullName).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
            Console.WriteLine($"Error loading data: {ex}");
        }
    }

    private void OnCustomerChanged()
    {
        // When customer is selected, pre-populate the assigned relationship manager if one exists
        if (relationship.CustomerId > 0)
        {
            var selectedCustomer = customers.FirstOrDefault(c => c.CustomerId == relationship.CustomerId);
            if (selectedCustomer != null && selectedCustomer.AssignedToUserId.HasValue)
            {
                assignedToUserId = selectedCustomer.AssignedToUserId.Value;
                currentCustomerAssignedUserId = selectedCustomer.AssignedToUserId.Value;
            }
            else
            {
                currentCustomerAssignedUserId = null;
            }
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            isSaving = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;

            // Validate required fields
            if (relationship.IndividualId <= 0)
            {
                errorMessage = "Please select an individual.";
                return;
            }

            if (relationship.CustomerId <= 0)
            {
                errorMessage = "Please select an organization.";
                return;
            }

            if (string.IsNullOrWhiteSpace(relationship.RoleInOrganization))
            {
                errorMessage = "Role in organization is required.";
                return;
            }

            // Validate role end date
            if (!relationship.IsStillActive && !relationship.RoleEndDate.HasValue)
            {
                errorMessage = "Please specify an end date if the role is no longer active.";
                return;
            }

            // Validate that role end date is after start date
            if (relationship.RoleStartDate.HasValue && relationship.RoleEndDate.HasValue
                && relationship.RoleEndDate.Value < relationship.RoleStartDate.Value)
            {
                errorMessage = "Role end date cannot be before the start date.";
                return;
            }

            // Check if this relationship already exists
            var existingRelationships = await RelationshipRepo.GetByCustomerIdAsync(relationship.CustomerId);
            var isDuplicate = existingRelationships.Any(r =>
                r.IndividualId == relationship.IndividualId &&
                r.RoleInOrganization == relationship.RoleInOrganization &&
                r.IsStillActive);

            if (isDuplicate)
            {
                errorMessage = "This individual already has an active relationship with this role in the selected organization.";
                return;
            }

            // Save the relationship
            var relationshipId = await RelationshipRepo.AddAsync(relationship);

            if (relationshipId > 0)
            {
                // Update customer's assigned relationship manager if selected
                if (assignedToUserId > 0 && assignedToUserId != (currentCustomerAssignedUserId ?? 0))
                {
                    var customer = await CustomerRepo.GetByIdAsync(relationship.CustomerId);
                    if (customer != null)
                    {
                        customer.AssignedToUserId = assignedToUserId;
                        customer.AssignedDate = DateTime.Now;
                        customer.ModifiedDate = DateTime.Now;
                        customer.ModifiedBy = relationship.CreatedBy;

                        var updateResult = await CustomerRepo.UpdateAsync(customer);
                        if (!updateResult)
                        {
                            Console.WriteLine("Warning: Failed to update customer's assigned relationship manager");
                        }
                    }
                }

                successMessage = "Relationship created successfully!";
                // Navigate back to relationships list after a short delay
                await Task.Delay(1500);
                Navigation.NavigateTo("/relationships");
            }
            else
            {
                errorMessage = "Failed to create relationship. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
            Console.WriteLine($"Error creating relationship: {ex}");
        }
        finally
        {
            isSaving = false;
        }
    }
}
