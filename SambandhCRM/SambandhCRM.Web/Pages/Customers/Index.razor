@page "/customers"
@attribute [Authorize]
@inject ICustomerRepository CustomerRepo
@inject NavigationManager Navigation

<PageTitle>Customers - Sambandh CRM</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-people"></i> Customers</h3>
    <a href="/customers/create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add New Customer
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <input type="text" class="form-control" placeholder="Search customers..." @bind="searchTerm" @bind:event="oninput" @onkeyup="FilterCustomers" />
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="filterStatus" @bind:event="onchange" @onchange="FilterCustomers">
                    <option value="">All Status</option>
                    <option value="Prospect">Prospect</option>
                    <option value="ActiveLead">Active Lead</option>
                    <option value="Customer">Customer</option>
                    <option value="Dormant">Dormant</option>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="filterConstitution" @bind:event="onchange" @onchange="FilterCustomers">
                    <option value="">All Constitutions</option>
                    <option value="Company">Company</option>
                    <option value="Society">Society</option>
                    <option value="Trust/NGO">Trust/NGO</option>
                    <option value="Partnership/LLP">Partnership/LLP</option>
                    <option value="Individual/Proprietor">Individual/Proprietor</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary w-100" @onclick="ClearFilters">
                    <i class="bi bi-x-circle"></i> Clear
                </button>
            </div>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (!filteredCustomers.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No customers found matching your criteria.
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Customer Code</th>
                            <th>Name</th>
                            <th>Constitution</th>
                            <th>Business Segment</th>
                            <th>Contact</th>
                            <th>Status</th>
                            <th>Created Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in filteredCustomers)
                        {
                            <tr>
                                <td>@customer.CustomerCode</td>
                                <td>
                                    <strong>@customer.EntityName</strong>
                                    @if (!string.IsNullOrEmpty(customer.PANNumber))
                                    {
                                        <br /><small class="text-muted">PAN: @customer.PANNumber</small>
                                    }
                                </td>
                                <td>@customer.LegalConstitution</td>
                                <td>@customer.BusinessSegment</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(customer.MobileNumber))
                                    {
                                        <div><i class="bi bi-phone"></i> @customer.MobileNumber</div>
                                    }
                                    @if (!string.IsNullOrEmpty(customer.PrimaryEmail))
                                    {
                                        <div><i class="bi bi-envelope"></i> @customer.PrimaryEmail</div>
                                    }
                                </td>
                                <td><span class="badge bg-@GetStatusColor(customer.CustomerStatus)">@customer.CustomerStatus</span></td>
                                <td>@customer.CreatedDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <a href="/customers/@customer.CustomerId" class="btn btn-sm btn-outline-primary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="/customers/edit/@customer.CustomerId" class="btn btn-sm btn-outline-secondary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-3">
                <p class="text-muted">Showing @filteredCustomers.Count() of @allCustomers.Count() customers</p>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private List<Customer> allCustomers = new();
    private List<Customer> filteredCustomers = new();
    private string searchTerm = string.Empty;
    private string filterStatus = string.Empty;
    private string filterConstitution = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        try
        {
            isLoading = true;
            var customers = await CustomerRepo.GetAllAsync();
            allCustomers = customers.ToList();
            filteredCustomers = allCustomers;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customers: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterCustomers()
    {
        filteredCustomers = allCustomers.Where(c =>
            (string.IsNullOrEmpty(searchTerm) ||
             c.EntityName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             c.CustomerCode.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             (c.PANNumber?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (c.MobileNumber?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)) &&
            (string.IsNullOrEmpty(filterStatus) || c.CustomerStatus == filterStatus) &&
            (string.IsNullOrEmpty(filterConstitution) || c.LegalConstitution == filterConstitution)
        ).ToList();
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        filterStatus = string.Empty;
        filterConstitution = string.Empty;
        filteredCustomers = allCustomers;
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "Prospect" => "info",
            "ActiveLead" => "warning",
            "Customer" => "success",
            "Dormant" => "secondary",
            "Archived" => "dark",
            _ => "secondary"
        };
    }
}
