@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="ms-auto" style="color: white;">
                        <i class="bi bi-person-circle"></i> @context.User.Identity?.Name
                        <a href="/logout" class="ms-3 btn btn-sm btn-outline-secondary" style="color: white;">Logout</a>
                    </span>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="ms-auto btn btn-sm btn-primary">Login</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
